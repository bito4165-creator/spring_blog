{{> layout/header}}

<div class="container p-5">
    <div class="card col-md-6 offset-md-3">
        <div class="card-header"><b>휴대폰 본인 인증</b></div>
        <div class="card-body">

            <!-- 휴대폰 번호 입력 및 전송 영역 -->
            <div class="mb-3">
                <label for="phoneNumber" class="form-label">휴대폰 번호</label>
                <div class="input-group">
                    <input type="text" id="phoneNumber" class="form-control"
                           placeholder="'-' 없이 번호 입력 (예: 01012345678)">
                    <button type="button" id="btnSend" class="btn btn-outline-primary" onclick="sendCode()">인증번호 전송
                    </button>
                </div>
            </div>

            <!-- 인증번호 입력 및 확인 영역 -->
            <div class="mb-3">
                <label for="code" class="form-label">인증번호</label>
                <div class="input-group">
                    <input type="text" id="code" class="form-control" placeholder="인증번호 6자리 입력">
                    <button type="button" id="btnVerify" class="btn btn-outline-success" onclick="verifyCode()">인증 확인
                    </button>
                </div>
            </div>

            <div id="resultMessage" class="mb-3 text-center fw-bold"></div>

            <div class="d-flex justify-content-between">
                <a href="/user/detail" class="btn btn-secondary">마이페이지로</a>
            </div>

        </div>
    </div>
</div>

<script>
    // 인증 완료 여부 (화면 안내용, 실제 검사는 서버의 세션으로 함)
    let isSmsVerified = false;

    // 1. 인증번호 전송 요청
    async function sendCode() {
        const phoneNumber = document.querySelector("#phoneNumber").value;
        if (!phoneNumber) {
            alert("휴대폰 번호를 입력해주세요");
            return;
        }

        // 문자 발송은 몇 초 시간이 걸리므로, 중복 요청 방지를 위해 버튼을 막아 중복 요청을 방지 한다
        const sendBtn = document.querySelector("#btnSend");
        sendBtn.disabled = true;
        sendBtn.innerText = "전송 중..."

        try {
            const response = await fetch("/api/sms/send", {
                method: "POST",
                headers: {"Content-Type": "application/json"},
                body: JSON.stringify({phoneNumber: phoneNumber})
            });

            const result = await response.json();
            alert(result.message);

            const msgDiv = document.querySelector("#resultMessage");
            if (response.ok) {
                msgDiv.className = "mb-3 text-center fw-bold text-primary"
                msgDiv.innerText = result.message
            } else {
                msgDiv.className = "mb-3 text-center fw-bold text-danger";
                msgDiv.innerText = result.message || "발송에 실패했습니다";
            }
        } catch (e) {
            console.log(e);
            alert("서버와 통신하지 못했습니다.")
        } finally {
            sendBtn.disabled = false;
            sendBtn.innerText = "인증번호 전송";
        }
    }

    // 2. 인증번호 확인 요청
    async function verifyCode() {
        const phoneNumber = document.querySelector("#phoneNumber").value;
        const code = document.querySelector("#code").value;
        const msgDiv = document.querySelector("#resultMessage");

        if (!code) {
            alert("인증번호를 입력해주세요");
            return;
        }

        try {
            const response = await fetch("/api/sms/verify", {
                method: "POST",
                headers: {"Content-Type": "application/json"},
                body: JSON.stringify({phoneNumber : phoneNumber, code : code})
            });

            const result =await response.json();

            if (response.ok) {
                isSmsVerified = true;
                msgDiv.className = "mb-3 text-center fw-bold text-success";
                msgDiv.innerText = result.message;

                // 인증 성공시 수정하지 못하도록 입력창및 버튼 잠금
                document.querySelector("#phoneNumber").readOnly = true;
                document.querySelector("#code").readOnly = true ;
                document.querySelector("#btnSend").disabled = true;
                document.querySelector("#btnVerify").disabled = true;
                alert("휴대폰 인증이 완료되었습니다.");
            } else {
                msgDiv.className = "mb-3 text-center fw-bold text-danger";
                msgDiv.innerText = result.message || "인증 실패";
            }

        } catch (e) {
            console.log(e);
            alert("서버와 통신하지 못했습니다.")
        }
    }

    // 3. 인증 완료 여부 확인 함수 (필요시 회원가입이나 정보 수정 제출 시 활용)
    async function checkSmsVerify() {
        if (!isSmsVerified) {
            alert("휴대폰 인증 먼저 해주세요");
            return false;
        }
        return true;
    }
</script>

{{> layout/footer}}