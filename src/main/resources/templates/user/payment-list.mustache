{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header"><h4><b>결제 내역</b></h4></div>
        <div class="card-body">
            <!-- 결제 내역 반복문 시작 -->
            {{#paymentList}}
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h5 class="card-title fw-bold mb-2">결제 #{{rowNum}}</h5>
                                <p class="text-secondary mb-1 small">
                                    <i class="fa-solid fa-receipt me-1"></i>주문번호: {{paymentId}}
                                </p>
                                <p class="text-secondary mb-1 small">
                                    <i class="fa-solid fa-key me-1"></i>결제번호: {{pgTxId}}
                                </p>
                                <p class="text-secondary mb-1 small">
                                    <i class="fa-solid fa-calendar me-1"></i>결제일: {{purchasedAt}}
                                </p>
                                <p class="text-secondary mb-0 small">
                                    <i class="fa-solid fa-circle-info me-1"></i>상태:
                                    <span class="badge bg-success">{{status}}</span>
                                </p>
                            </div>
                            <div class="tex-end">
                                <span class="badge bg-primary fs-6">{{amount}} P</span>
                            </div>
                        </div>
                    </div>
                </div>
            {{/paymentList}}
            <!-- 결제 내역 반복문 종료 .. -->
            <!-- 결제 내역이 없을 때 (반전 섹션 태그 활용)  -->
            {{^paymentList}}
            <div class="text-center py-5">
                <i class="fa-solid fa-cart-shopping fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">결제 내역이 없습니다</h5>
                <h5 class="text-muted">포인트를 충전해보세요</h5>
                <a href="/user/point/charge" class="btn btn-primary">포인트 충전하기</a>
            </div>
            {{/paymentList}}
            <!-- 마이페이지 돌아가는 버튼 -->
            <div class="mb-4">
                <a href="/user/detail" class="btn btn-secondary">마이페이지 돌아가기</a>
            </div>
        </div>
    </div>
</div>
{{> layout/footer}}